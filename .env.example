# Copy to .env and fill in. Keep comments on their own lines:
# an inline comment after a value becomes part of the value.

# ==============================
# ANTHROPIC
# ==============================
ANTHROPIC_API_KEY=your-anthropic-api-key
DEFAULT_MODEL=claude-sonnet-4-6
THINKING_MODEL=claude-opus-4-7
THINKING_BUDGET=8000

# Times to retry one Claude API call when the connection drops partway through
# the response (seen as "peer closed connection ... incomplete chunked read").
# 0 turns retrying off. Each retry starts that call over: Claude repeats its
# web searches, and the dropped attempt's tokens may still be billed.
CLAUDE_CONNECTION_RETRIES=1


# ==============================
# VETTING THROTTLES
# ==============================
# Max concurrent Claude vetting calls (each is a live API call with web search)
VETTING_MAX_WORKERS=4

# Max companies vetted per run (keeps a run inside the Lambda time limit)
VETTING_MAX_COMPANIES=10

# Minimum days before an already-vetted company can be re-vetted
VETTING_REVET_AFTER_DAYS=90


# ==============================
# CLAUDE OUTPUT CAPS (max_tokens per request)
# ==============================
# Company vetting: one scoring form per company
VETTING_MAX_TOKENS=4096
# Inclusion references: three small sources
INCLUSION_REFS_MAX_TOKENS=8000
# EEOC age actions: full 5-year window, the big one
EEOC_AGE_ACTIONS_MAX_TOKENS=32000


# ==============================
# DJANGO
# ==============================
# Required, no default. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key


# ==============================
# LOGGING
# ==============================
# Django and third-party libraries
LOG_LEVEL=INFO
# Our code (crawler.*). DEBUG while developing, INFO in production.
APP_LOG_LEVEL=DEBUG
# Set to DEBUG to log every SQL query (also requires DEBUG=True)
SQL_LOG_LEVEL=INFO


# ==============================
# DATABASE SETTINGS
# ==============================
# MySQL backend works for MariaDB
DB_ENGINE=django.db.backends.mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_tracker
DB_USER=root
# Quote the password if it contains #, $, or spaces
DB_PASSWORD=your-db-password
